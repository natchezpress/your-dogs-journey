{
  // Cloudflare Workers deploy config for the Dedication Maker and Wall.
  // Built by Workers Builds on every push (root web/, `npm run build`, `npx wrangler deploy`).
  // The static maker is served from ./dist through the ASSETS binding; worker.js answers everything else.
  "name": "your-dogs-journey",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Let the Worker run first for API and wall routes; static files still win for everything else.
    "run_worker_first": ["/api/*", "/d/*", "/wall", "/memory", "/i/*", "/rounds/*", "/rules", "/privacy", "/terms", "/admin", "/admin/*", "/p/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "dedication-wall", "database_id": "344030a2-af4e-4963-9d8b-01a97b6059ae", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "dedication-photos" }
  ],
  "vars": {
    // Posting stays off on the live site until the wall passes its test (design doc, schedule gate Nov 23).
    "POSTING_ENABLED": "false",
    // DEV_MODE returns the sign-in link in the API response when no mail key is set; never true in production.
    "DEV_MODE": "false",
    "SITE_URL": "https://dedication.jetsonsjourney.com",
    "CONTACT_EMAIL": "admin@brockalston.com"
  },
  "triggers": {
    // Daily at 13:00 UTC (7 a.m. Central in winter, 8 a.m. in summer): digest, anniversaries, thresholds.
    "crons": ["0 13 * * *"]
  },
  "observability": { "enabled": true }
}
